Windows Registry Editor Version 5.00

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows Defender Security Center\Notifications]
"DisableNotifications"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows Defender Security Center\Systray]
"HideSystray"=dword:00000001

[HKEY_LOCAL_MACHINE\Software\Policies\Microsoft\Windows Defender]
"AllowFastServiceStartup"=dword:00000000
"DisableAntiSpyware"=dword:00000001
"DisableRoutinelyTakingAction"=dword:00000001
"ServiceKeepAlive"=dword:00000000

[HKEY_LOCAL_MACHINE\software\policies\microsoft\windows defender\smartscreen]
"configureappinstallcontrol"=-
"ConfigureAppInstallControlEnabled"=dword:00000000

[HKEY_LOCAL_MACHINE\software\policies\microsoft\windows\deviceguard]
"configuresystemguardlaunch"=-
"hypervisorenforcedcodeintegrity"=-
"lsacfgflags"=-
"requireplatformsecurityfeatures"=-
"EnableVirtualizationBasedSecurity"=dword:00000000
"HVCIMATRequired"=dword:00000000

[HKEY_LOCAL_MACHINE\software\policies\microsoft\windows\system]
"shellsmartscreenlevel"=-
"DisableHHDEP"=dword:00000001
"EnableSmartScreen"=dword:00000000